{
	"buildCommand": "npx prisma migrate deploy && npx prisma generate && npm run build",
	"installCommand": "npm install --include=dev",
	"functions": {
		"api/index.ts": {
			"maxDuration": 30,
			"runtime": "nodejs20.x"
		}
	},
	"rewrites": [
		{
			"source": "/(.*)",
			"destination": "/api/index"
		}
	]
}
