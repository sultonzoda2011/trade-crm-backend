generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String         @id @default(uuid())
  name           String
  email          String         @unique
  password       String
  role           Role
  marketId       String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  transactions   Transaction[]
  payments       Payment[]
  market         Market?        @relation(fields: [marketId], references: [id])
  ownedMarkets   Market[]       @relation("MarketOwner")
  refreshTokens  RefreshToken[]

  @@index([marketId])
}

model RefreshToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([userId])
  @@index([token])
}

model Market {
  id           String        @id @default(uuid())
  name         String
  address      String
  image        String?
  ownerId      String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  owner        User          @relation("MarketOwner", fields: [ownerId], references: [id])
  debtors      Debtor[]
  products     Product[]
  categories   Category[]
  transactions Transaction[]
  users        User[]
}

model Category {
  id        String    @id @default(uuid())
  name      String
  marketId  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  market    Market    @relation(fields: [marketId], references: [id], onDelete: Cascade)
  products  Product[]

  @@index([marketId])
  @@unique([marketId, name])
}

model Product {
  id                String            @id @default(uuid())
  name              String
  description       String?
  price             Float
  quantity          Int
  unit              ProductUnit       @default(PCS)
  lowStockThreshold Int               @default(0)
  image             String?
  marketId          String
  categoryId        String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  market            Market            @relation(fields: [marketId], references: [id])
  category          Category?         @relation(fields: [categoryId], references: [id])
  transactionItems  TransactionItem[]

  @@index([marketId])
  @@index([categoryId])
}

model Debtor {
  id           String        @id @default(uuid())
  name         String
  phone        String
  marketId     String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  market       Market        @relation(fields: [marketId], references: [id])
  transactions Transaction[]

  @@index([marketId])
}

model Transaction {
  id              String            @id @default(uuid())
  marketId        String
  createdById     String
  debtorId        String?
  refundOfId      String?           @unique
  type            TransactionType
  paymentType     PaymentType
  totalAmount     Float
  discountAmount  Float             @default(0)
  remainingAmount Float             @default(0)
  status          TransactionStatus
  dueDate         DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  createdBy       User              @relation(fields: [createdById], references: [id])
  debtor          Debtor?           @relation(fields: [debtorId], references: [id])
  market          Market            @relation(fields: [marketId], references: [id])
  refundOf        Transaction?      @relation("TransactionRefund", fields: [refundOfId], references: [id])
  refund          Transaction?      @relation("TransactionRefund")
  items           TransactionItem[]
  payments        Payment[]

  @@index([marketId])
  @@index([debtorId])
  @@index([createdById])
}

model TransactionItem {
  id            String      @id @default(uuid())
  transactionId String
  productId     String
  productName   String
  quantity      Int
  price         Float
  discount      Float       @default(0)
  totalPrice    Float
  product       Product     @relation(fields: [productId], references: [id])
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@index([productId])
}

model Payment {
  id            String      @id @default(uuid())
  transactionId String
  amount        Float
  note          String?
  createdById   String
  createdAt     DateTime    @default(now())
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  createdBy     User        @relation(fields: [createdById], references: [id])

  @@index([transactionId])
  @@index([createdById])
}

enum Role {
  ADMIN
  OWNER
  SELLER
}

enum TransactionType {
  SALE
  DEBT
  REFUND
}

enum PaymentType {
  CASH
  CARD
  CREDIT
}

enum TransactionStatus {
  PAID
  ACTIVE
  PARTIAL
  REFUNDED
}

enum ProductUnit {
  PCS
  KG
  L
  M
  BOX
}
