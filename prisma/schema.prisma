generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(uuid())
  name          String
  email         String         @unique
  password      String
  role          Role
  marketId      String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  image         String?
  ownedMarkets  Market[]       @relation("MarketOwner")
  payments      Payment[]
  transactions  Transaction[]
  market        Market?        @relation(fields: [marketId], references: [id])
  creditsReceived SellerCredit[] @relation("SellerCredits")
  creditsGiven    SellerCredit[] @relation("CreditsGivenBy")

  @@index([marketId])
}



model Market {
  id           String        @id @default(uuid())
  name         String
  address      String
  ownerId      String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  image        String?
  categories   Category[]
  debtors      Debtor[]
  owner        User          @relation("MarketOwner", fields: [ownerId], references: [id])
  products     Product[]
  transactions Transaction[]
  users        User[]
}

model Category {
  id          String    @id @default(uuid())
  name        String
  marketId    String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  description String?
  image       String?
  market      Market    @relation(fields: [marketId], references: [id], onDelete: Cascade)
  products    Product[]

  @@unique([marketId, name])
  @@index([marketId])
}

model Product {
  id                String            @id @default(uuid())
  name              String
  price             Float
  quantity          Int
  marketId          String
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  image             String?
  description       String?
  categoryId        String?
  lowStockThreshold Int               @default(0)
  unit              ProductUnit       @default(PCS)
  category          Category?         @relation(fields: [categoryId], references: [id])
  market            Market            @relation(fields: [marketId], references: [id])
  transactionItems  TransactionItem[]

  @@index([marketId])
  @@index([categoryId])
}

model Debtor {
  id           String        @id @default(uuid())
  name         String
  phone        String
  marketId     String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  market       Market        @relation(fields: [marketId], references: [id])
  transactions Transaction[]

  @@index([marketId])
}

model Transaction {
  id              String            @id @default(uuid())
  marketId        String
  createdById     String
  debtorId        String?
  type            TransactionType
  paymentType     PaymentType
  totalAmount     Float
  status          TransactionStatus
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  remainingAmount Float             @default(0)
  discountAmount  Float             @default(0)
  // Сумма надбавок (markup) по всем позициям — сколько сверху цены накинули
  // за эту транзакцию. Хранится агрегатом здесь же, чтобы не пересчитывать
  // сумму по items на каждый список/отчёт.
  markupAmount    Float             @default(0)
  dueDate         DateTime?
  // Необязательный покупатель для SALE-транзакции («кому продали»).
  // Для DEBT не используется: там покупатель — должник (debtorId).
  customerName    String?
  // Одна SALE может иметь НЕСКОЛЬКО частичных возвратов, поэтому здесь нет
  // @unique. Ограничение «нельзя вернуть больше купленного» держится на
  // TransactionItem.refundedQuantity, а не на уникальности этой связи.
  refundOfId      String?
  payments        Payment[]
  createdBy       User              @relation(fields: [createdById], references: [id])
  debtor          Debtor?           @relation(fields: [debtorId], references: [id])
  market          Market            @relation(fields: [marketId], references: [id])
  refundOf        Transaction?      @relation("TransactionRefund", fields: [refundOfId], references: [id])
  refunds         Transaction[]     @relation("TransactionRefund")
  items           TransactionItem[]

  @@index([marketId])
  @@index([debtorId])
  @@index([createdById])
  @@index([refundOfId])
  @@index([marketId, type, createdAt])
  @@index([createdById, type, createdAt])
}

model TransactionItem {
  id            String      @id @default(uuid())
  transactionId String
  productId     String
  productName   String
  quantity      Int
  price         Float
  totalPrice    Float
  discount      Float       @default(0)
  // Надбавка сверху цены за эту позицию — противоположность discount.
  // Может добавить любая роль при создании транзакции, но накопление и
  // выплата (SellerCredit) считается только для строк, где создатель
  // транзакции — SELLER.
  markup        Float       @default(0)
  // Сколько единиц этой строки уже возвращено. Растёт при каждом частичном
  // возврате и служит единственным источником правды для проверки
  // «нельзя вернуть больше купленного». На строках REFUND-транзакций всегда 0.
  refundedQuantity Int      @default(0)
  // Ссылка со строки REFUND на исходную строку SALE — позволяет посчитать
  // возвраты в разрезе конкретной покупки, а не только товара.
  refundOfItemId String?
  refundOfItem   TransactionItem?  @relation("TransactionItemRefund", fields: [refundOfItemId], references: [id])
  refundItems    TransactionItem[] @relation("TransactionItemRefund")
  product       Product     @relation(fields: [productId], references: [id])
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@index([productId])
  @@index([refundOfItemId])
}

model Payment {
  id            String      @id @default(uuid())
  transactionId String
  amount        Float
  note          String?
  createdById   String
  createdAt     DateTime    @default(now())
  createdBy     User        @relation(fields: [createdById], references: [id])
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@index([createdById])
}

// Учёт выдачи накопленных надбавок (markup) продавцу. Баланс продавца —
// это Σ TransactionItem.markup по его транзакциям минус Σ SellerCredit.amount.
// Выдавать можно частями (amount может быть меньше текущего баланса).
model SellerCredit {
  id          String   @id @default(uuid())
  sellerId    String
  amount      Float
  note        String?
  createdById String
  createdAt   DateTime @default(now())
  seller      User     @relation("SellerCredits", fields: [sellerId], references: [id])
  createdBy   User     @relation("CreditsGivenBy", fields: [createdById], references: [id])

  @@index([sellerId])
}

// Персистентное хранилище rate limiting (PrismaThrottlerStorage).
// Одна строка на ключ «throttler:controller:handler:ip»; hits обновляются
// атомарно через INSERT ... ON CONFLICT в PrismaThrottlerStorage.
model ThrottleBucket {
  key          String    @id
  hits         Int
  expiresAt    DateTime
  blockedUntil DateTime?

  @@index([expiresAt])
}

enum Role {
  ADMIN
  OWNER
  SELLER
}

enum TransactionType {
  SALE
  DEBT
  REFUND
}

enum PaymentType {
  CASH
  CARD
  CREDIT
}

enum TransactionStatus {
  PAID
  ACTIVE
  PARTIAL
  REFUNDED
  PARTIALLY_REFUNDED
}

enum ProductUnit {
  PCS
  KG
  L
  M
  BOX
}

// Защита от дублей при повторной отправке мутации (офлайн-клиент ретраит
// запрос после обрыва связи, не зная, успел ли предыдущий дойти до сервера).
// Ключ передаётся клиентом в заголовке Idempotency-Key.
model IdempotencyKey {
  id         String   @id @default(uuid())
  key        String   @unique
  userId     String
  endpoint   String
  statusCode Int
  response   Json
  createdAt  DateTime @default(now())

  @@index([createdAt])
}
