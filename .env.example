# Database
DATABASE_URL="postgresql://user:password@host:5432/db?sslmode=require"
# Размер pg-пула на один инстанс. На Vercel ставьте 2-3: каждый serverless-инстанс
# держит свой пул, иначе Postgres быстро упирается в max_connections.
DATABASE_POOL_MAX=10

# JWT
JWT_ACCESS_SECRET="your-access-secret"
# Срок жизни токена. Refresh-токенов нет, поэтому держим долгий срок (по умолчанию 365d).
JWT_ACCESS_EXPIRES_IN="365d"

# Стоимость bcrypt для хеширования паролей (код по умолчанию: 12).
BCRYPT_ROUNDS=12

# Server
# 4000 — конвенция проекта: frontend/.env указывает VITE_API_URL на :4000.
# Внимание: если PORT не задан, код падает на дефолт 3000 (main.ts), и фронтенд
# в него не постучится. Не удаляйте эту переменную из локального .env.
PORT=4000
NODE_ENV=development

# Cloudinary
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
# Telegram-поддержка (src/support). Токены ботов выдаёт @BotFather; секреты webhook —
# любые случайные строки A-Z a-z 0-9 _ - (например `openssl rand -hex 32`), у каждого
# бота свой. Хранить только в env хостинга, не коммитить и не логировать.
SUPPORT_BOT_TOKEN=""
ADMIN_BOT_TOKEN=""
SUPPORT_WEBHOOK_SECRET=""
ADMIN_WEBHOOK_SECRET=""
# Telegram user ID админов через запятую (узнать: @userinfobot). Только они управляют Admin-ботом.
TELEGRAM_ADMIN_IDS=""
# Часовой пояс времени в «Истории» (по умолчанию Asia/Dushanbe).
SUPPORT_TIMEZONE="Asia/Dushanbe"
# Только для `npm run support:webhook`: https://<домен бэкенда>, без /api.
SUPPORT_PUBLIC_URL=""
